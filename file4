<!DOCTYPE html>
<html>
<head>
    <title>Image Slider</title>
    <style>
        /* Slider Container */
        .slider-container {
            width: 80%;
            height: 300px;
            margin: auto;
            overflow: hidden;
            position: relative;
        }

        /* Image Wrapper (for sliding effect) */
        .slider {
            display: flex;
            width: 300%;
            transition: transform 0.5s ease-in-out;
        }

        /* Individual Slide */
        .slide {
            width: 100%;
            flex: 0 0 100%;
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Navigation Buttons */
        .prev, .next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: rgba(0, 0, 0, 0.5);
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            font-size: 20px;
        }

        .prev { left: 10px; }
        .next { right: 10px; }
    </style>
</head>
<body>

    <!-- Slider Container -->
    <div class="slider-container">
        <div class="slider">
            <div class="slide"><img src="images/slide1.jpg" alt="Slide 1"></div>
            <div class="slide"><img src="images/slide2.jpg" alt="Slide 2"></div>
            <div class="slide"><img src="images/slide3.jpg" alt="Slide 3"></div>
        </div>

        <!-- Navigation Buttons -->
        <button class="prev" onclick="prevSlide()">&#10094;</button>
        <button class="next" onclick="nextSlide()">&#10095;</button>
    </div>

    <script>
        let currentIndex = 0;

        function showSlide(index) {
            const slider = document.querySelector('.slider');
            const totalSlides = document.querySelectorAll('.slide').length;
            
            if (index >= totalSlides) { currentIndex = 0; }
            else if (index < 0) { currentIndex = totalSlides - 1; }
            else { currentIndex = index; }
            
            slider.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        function nextSlide() { showSlide(currentIndex + 1); }
        function prevSlide() { showSlide(currentIndex - 1); }

        // Auto Slide every 3 seconds
        setInterval(() => { nextSlide(); }, 3000);
    </script>

</body>
</html>
